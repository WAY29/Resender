{
  "name": "resender",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "A Chrome DevTools extension for editing and resending Fetch/XHR requests.",
  "license": "GPL-3.0-only",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "dev": "vite",
    "build": "npm run icons && tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "jsdom": "^25.0.1",
    "pngjs": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
